---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../site';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// 篩選膠囊：All + 所有出現過的 kind
const kinds = [...new Set(projects.map((p) => p.data.kind))];
---

<Base>
  <section class="hero" data-reveal>
    <h1 class="hero__title">
      <strong>{site.heroLead}</strong> <span data-hero-rest>{site.heroRest}</span>
    </h1>

    <div class="filters" role="tablist" aria-label="專案類型">
      <button class="filter is-active" data-filter="all" role="tab" aria-selected="true">All</button>
      {
        kinds.map((k) => (
          <button class="filter" data-filter={k} role="tab" aria-selected="false">{k}</button>
        ))
      }
    </div>
  </section>

  <div class="grid" data-grid>
    {
      projects.map((p) => (
        <a class="card" href={`/work/${p.id}/`} data-card data-kind={p.data.kind}>
          <figure class="card__img">
            {p.data.cover && (
              <img src={p.data.cover} alt={p.data.title} loading="lazy" />
            )}
          </figure>
          <p class="card__cap">
            <strong>{p.data.title}</strong> — {p.data.summary}
          </p>
        </a>
      ))
    }
  </div>

  <p class="empty" data-empty hidden>沒有符合的專案。</p>

  <script is:inline define:vars={{ perPage: site.perPage }}>
    function initShowcase() {
      const grid = document.querySelector('[data-grid]');
      if (!grid) return;
      // 每個 grid 只初始化一次：astro:page-load 的監聽掛在 document 上，
      // 換頁回來會累積呼叫，沒有這道防線就會重複綁定造成一次跳好幾頁。
      if (grid.dataset.ready) return;
      grid.dataset.ready = '1';

      const cards = Array.from(grid.querySelectorAll('[data-card]'));
      const pills = Array.from(document.querySelectorAll('[data-filter]'));
      const empty = document.querySelector('[data-empty]');
      const prev = document.querySelector('[data-prev]');
      const next = document.querySelector('[data-next]');
      const count = document.querySelector('[data-count]');
      const heroRest = document.querySelector('[data-hero-rest]');
      const heroText = heroRest ? heroRest.textContent : '';

      let filter = 'all';
      let page = 0;

      const matched = () =>
        filter === 'all' ? cards : cards.filter((c) => c.dataset.kind === filter);

      function render() {
        const list = matched();
        const pages = Math.max(1, Math.ceil(list.length / perPage));
        page = Math.min(page, pages - 1);

        const visible = list.slice(page * perPage, page * perPage + perPage);

        cards.forEach((c) => {
          const i = visible.indexOf(c);
          c.hidden = i === -1;
          if (i !== -1) {
            // 依序浮現：每張卡延遲 --i * 45ms
            c.style.setProperty('--i', String(i));
            c.classList.remove('is-in');
            void c.offsetWidth;
            c.classList.add('is-in');
          }
        });

        // 翻到第 2 頁以後，標題後段換成「— Page N」
        if (heroRest) {
          heroRest.textContent = page > 0 ? `— Page ${page + 1}` : heroText;
          heroRest.classList.toggle('hero__page', page > 0);
        }

        if (empty) empty.hidden = list.length > 0;
        if (prev) prev.disabled = page === 0;
        if (next) next.disabled = page >= pages - 1;
        if (count) count.textContent = pages > 1 ? `${page + 1} / ${pages}` : '';
      }

      pills.forEach((btn) => {
        btn.addEventListener('click', () => {
          pills.forEach((b) => {
            const on = b === btn;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-selected', String(on));
          });
          filter = btn.dataset.filter;
          page = 0;
          render();
        });
      });

      prev?.addEventListener('click', () => {
        if (page <= 0) return;
        page -= 1;
        render();
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      next?.addEventListener('click', () => {
        const pages = Math.max(1, Math.ceil(matched().length / perPage));
        if (page >= pages - 1) return;
        page += 1;
        render();
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      render();
    }

    // dock（含 Prev/Next）排在 <main> 之後，所以要等 DOM 解析完才抓得到
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShowcase, { once: true });
    } else {
      initShowcase();
    }
    document.addEventListener('astro:page-load', initShowcase);
  </script>
</Base>
